{
  "$schema": "node_modules/wrangler/config-schema.json",

  // IMPORTANTE: este nombre debe ser EXACTAMENTE el del Worker que ya tiene
  // el dominio tantraparaparejas.com. Si no coincide, el despliegue crea un
  // Worker nuevo y el dominio sigue apuntando al antiguo.
  // Se comprueba en Cloudflare → Workers & Pages → (tu Worker).
  "name": "para-parejas",
  "compatibility_date": "2026-11-11",

  // El build de Angular deja el sitio prerenderizado aquí.
  "assets": {
    "directory": "./dist/app/browser"
  }
}
